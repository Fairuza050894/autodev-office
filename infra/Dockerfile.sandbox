FROM node:22-bookworm-slim
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends git zip ca-certificates chromium && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/playwright
RUN npm init -y && npm install playwright@1.51.1
COPY infra/external-uat.mjs /opt/autodev/external-uat.mjs
ENV NODE_PATH=/opt/playwright/node_modules
ENV CHROMIUM_PATH=/usr/bin/chromium
ENV HOME=/tmp
USER 1000:1000
WORKDIR /workspace
CMD ["node", "server.mjs"]
