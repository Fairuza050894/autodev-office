# Skema lokal: salin menjadi .env untuk `docker compose up`. Kunci URL internal
# (PUBLIC_URL/DASHBOARD_URL/dll). Jangan campur dengan *_DOMAIN (skema prod).
# Nilai bawaan hanya untuk demo lokal. docker compose up tidak memerlukan file .env.
POSTGRES_PASSWORD=autodev-local-db
SESSION_SECRET=local-only-change-this-secret-before-production-2026
RUNNER_TOKEN=local-only-runner-token-change-before-production-2026
SETTINGS_KEY=
PUBLIC_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
# Jangan samakan hostname aplikasi generated dengan dashboard/API.
PUBLIC_LIVE_URL=http://127.0.0.1:4400
ADMIN_EMAIL=admin@autodev.local
ADMIN_PASSWORD=AutoDevLocal2026!
LLM_MODE=mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
WORKER_CONCURRENCY=4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=AutoDev Office <office@autodev.local>
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_WEBHOOK_SECRET=
MINIO_ROOT_USER=autodev
MINIO_ROOT_PASSWORD=autodev-local-storage
GITEA_USER=autodev
GITEA_PASSWORD=AutoDevGitLocal2026!
GITEA_TOKEN=
# Untuk menjalankan API langsung pada host, ganti DATABASE_URL/REDIS_URL dan
# expose port DB/Redis dengan compose override lokal, bukan akses publik.
DATABASE_URL=postgresql://autodev:autodev-local-db@localhost:5432/autodev
REDIS_URL=redis://localhost:6379
PORT=4000
RUNNER_URL=http://runner:4100
WORKSPACE_ROOT=/workspaces
ARTIFACT_ROOT=/workspaces
DEPLOY_TARGET=docker-local
SNAPSHOT_RETENTION_DAYS=30
# Target coolify wajib source app terkonfigurasi dan health berisi versi release.
COOLIFY_URL=
COOLIFY_TOKEN=
COOLIFY_APP_UUID=
COOLIFY_PUBLIC_URL=
# External browser UAT: jaringan internal khusus hanya akses proxy allowlist.
UAT_PROXY_URL=
UAT_EGRESS_NETWORK=
