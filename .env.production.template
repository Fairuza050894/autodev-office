# Skema prod: salin ke .env.production untuk `docker compose -f docker-compose.prod.yml`.
# Kunci *_DOMAIN (bukan *_URL); DASHBOARD_URL diturunkan dari DASHBOARD_DOMAIN.
# JANGAN commit .env.production (sudah di-ignore).
#   cp .env.production.template .env.production
#
# Generate secret acak:
#   openssl rand -base64 32

# --- Domain publik (DNS A record -> IP VPS; dashboard tetap di Vercel) ---
API_DOMAIN=api.example.com
LIVE_DOMAIN=live.example.com
GITEA_DOMAIN=git.example.com
MINIO_DOMAIN=s3.example.com
DASHBOARD_DOMAIN=autodev-office-fairuzareztu-3191s-projects.vercel.app

# --- Postgres ---
POSTGRES_PASSWORD=isi-password-kuat-disini

# --- Session & enkripsi (wajib diganti, minimal 32 char acak) ---
SESSION_SECRET=isi-secret-acak-32char-minimal
SETTINGS_KEY=isi-key-acak-32char-minimal

# --- Admin awal ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=isi-password-admin-kuat

# --- Runner ---
RUNNER_TOKEN=isi-token-acak-32char-minimal

# --- LLM ---
LLM_MODE=real
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
WORKER_CONCURRENCY=4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Email ---
EMAIL_PROVIDER=smtp
EMAIL_FROM=AutoDev Office <office@example.com>
EMAIL_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# --- MinIO / S3 ---
MINIO_ROOT_USER=autodev
MINIO_ROOT_PASSWORD=isi-password-kuat-disini
S3_REGION=us-east-1
S3_BUCKET=autodev-artifacts
S3_ENDPOINT=

# --- Backup harian (one-shot via cron host, lihat docker-compose.prod.yml) ---
BACKUP_RETENTION_DAYS=30

# --- Gitea ---
GITEA_USER=autodev
GITEA_PASSWORD=
GITEA_TOKEN=

# --- Deploy target (opsional) ---
DEPLOY_TARGET=docker-local
SNAPSHOT_RETENTION_DAYS=30
COOLIFY_URL=
COOLIFY_TOKEN=
COOLIFY_APP_UUID=
COOLIFY_PUBLIC_URL=
UAT_PROXY_URL=
UAT_EGRESS_NETWORK=
