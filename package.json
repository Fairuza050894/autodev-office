{
  "name": "autodev-office",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:all": "pnpm --parallel --filter './apps/*' dev & npx cloudflared tunnel --url http://localhost:4000",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_BASE_URL=https://autodev-office-fairuzareztu-3191s-projects.vercel.app playwright test",
    "lint": "eslint .",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
